---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
export const prerender = true;
---

<Layout
  title="Contact | Jack Faris"
  description="Get in touch with Jack Faris about robotics, medical devices, sales leadership, or AI consulting."
>
  <section class="hero hero-compact">
    <div class="container page-intro">
      <h1 class="text-gradient">Contact</h1>
      <p>Interested in connecting? I'm always open to discussing new opportunities, partnerships, or ideas.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="contact-panel glass-panel">
        <h2 class="text-gradient-red">Let's Build Something Together</h2>
        <p class="contact-lead">My mission is to solve problems and create value. Fill out the form below to send an email directly to my inbox.</p>

        <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="8ffe1364-a50c-49bd-911c-ca68678ad078">

          <div class="form-row">
            <div class="form-field">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your Name">
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="your.email@example.com">
            </div>
          </div>

          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" required placeholder="How can I bring value to your team or project?"></textarea>
          </div>

          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off">

          <button type="submit" class="btn btn-full">Send Message</button>
        </form>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header">
        <h2 class="text-gradient-red">Get in Touch</h2>
        <p>Whether you're interested in my experience with robotics and medical devices, want to discuss AI and automation for your business, or just want to connect — I'd love to hear from you.</p>
      </div>

      <div class="grid grid-2">
        <div class="card glass-panel">
          <h3>Contact Information</h3>
          <div class="contact-methods">
            <div class="contact-method">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              </span>
              <div>
                <strong>Email</strong>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </div>
            </div>

            <div class="contact-method">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <path d="M8 11h8M8 15h5" />
                </svg>
              </span>
              <div>
                <strong>LinkedIn</strong>
                <a href={site.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/jack-faris</a>
              </div>
            </div>

            <div class="contact-method">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
              </span>
              <div>
                <strong>Location</strong>
                <span>{site.location}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card glass-panel">
          <h3>What I'm Interested In</h3>
          <ul class="interest-list">
            <li>Robotics and medical device opportunities</li>
            <li>Sales leadership and team development roles</li>
            <li>AI and automation consulting for small businesses</li>
            <li>Partnerships that create value for society</li>
            <li>Building something meaningful from the ground up</li>
          </ul>

          <div class="card-divider">
            <h3 class="card-subtitle">Response Time</h3>
            <p>I typically respond to emails within 24–48 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
