---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout
  title="Investing | Jack Faris"
  description="Jack's Picks: a live scorecard of the stocks Jack tracks with entry prices, compared against the S&P 500 over the same period."
>
  <section class="hero hero-compact">
    <div class="container">
      <div class="hero-text">
        <p class="hero-eyebrow">Investing</p>
        <h1>Jack's Picks vs. the Market</h1>
        <p>
          A live scorecard of the stocks I buy — entry price, current value, and how they
          stack up against the S&amp;P&nbsp;500 over the same period. Everyone can view the
          board; only I can change it. Prices update from Yahoo Finance.
        </p>
      </div>
    </div>
  </section>

  <section class="investing-section">
    <div class="container">
      <div class="investing-grid">
        <!-- Owner controls (hidden unless the owner code is entered) -->
        <div class="glass-panel invest-panel owner-panel hidden" id="owner-panel">
          <h2>Edit Jack's Picks</h2>
          <p class="owner-hint">You're in owner mode. Add or remove picks below — changes go live for everyone immediately.</p>
          <form id="add-position-form" autocomplete="off">
            <div class="form-row">
              <div class="form-field">
                <label for="p-symbol">Ticker *</label>
                <input type="text" id="p-symbol" name="symbol" placeholder="AAPL" required
                  pattern="[A-Za-z0-9.\-^]{1,12}" />
              </div>
              <div class="form-field">
                <label for="p-name">Name <span class="label-hint">(optional)</span></label>
                <input type="text" id="p-name" name="name" placeholder="Apple Inc." maxlength="60" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-field">
                <label for="p-price">Buy price (USD) *</label>
                <input type="text" id="p-price" name="price" placeholder="250.00" required inputmode="decimal" />
              </div>
              <div class="form-field">
                <label for="p-date">Buy date *</label>
                <input type="date" id="p-date" name="date" required />
              </div>
            </div>
            <div class="form-field">
              <label for="p-shares">Shares <span class="label-hint">(for total value; defaults to 1)</span></label>
              <input type="text" id="p-shares" name="shares" placeholder="10" inputmode="decimal" />
            </div>
            <div class="form-field">
              <label for="p-note">Why I picked it <span class="label-hint">(optional)</span></label>
              <input type="text" id="p-note" name="note" placeholder="Foundry upside" maxlength="140" />
            </div>
            <div id="add-position-status" class="invest-status" role="status" aria-live="polite"></div>
            <button type="submit" class="btn btn-full" id="add-position-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round" />
              </svg>
              Add this pick
            </button>
          </form>
          <div class="owner-actions">
            <button class="btn-secondary btn btn-sm" id="export-btn" type="button">Export JSON</button>
            <button class="btn-secondary btn btn-sm" id="import-btn" type="button">Import JSON</button>
            <input type="file" id="import-file" accept="application/json,.json" class="hidden" aria-hidden="true" tabindex="-1" />
            <button class="btn-ghost btn btn-sm" id="clear-btn" type="button">Clear all</button>
            <button class="btn-ghost btn btn-sm" id="lock-btn" type="button">Lock (exit)</button>
          </div>
          <p class="fineprint">Import replaces the whole board. Use Export first to keep a backup.</p>
        </div>

        <!-- Owner lock (shown to visitors / owner not yet unlocked) -->
        <div class="glass-panel invest-panel owner-lock" id="owner-lock">
          <div class="lock-ico" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
            </svg>
          </div>
          <h2>View-only</h2>
          <p class="lock-copy">
            You're viewing Jack's live board. Only Jack can add or remove picks — if you have
            the owner code, enter it to unlock editing.
          </p>
          <form id="owner-form" autocomplete="off">
            <div class="form-field">
              <label for="owner-code">Owner code</label>
              <input type="text" id="owner-code" name="owner-code" placeholder="••••-••••-••••"
                autocomplete="off" spellcheck="false" style="letter-spacing:.15em" />
            </div>
            <div id="owner-status" class="invest-status" role="status" aria-live="polite"></div>
            <button type="submit" class="btn btn-full" id="unlock-btn">Unlock editing</button>
          </form>
        </div>

        <!-- Portfolio -->
        <div class="glass-panel invest-panel invest-panel-wide">
          <div class="invest-panel-head">
            <h2 id="board-title">Jack's picks</h2>
            <div class="invest-tools">
              <select id="compare-select" aria-label="Compare against">
                <option value="^GSPC" selected>S&amp;P 500</option>
                <option value="NDX">Nasdaq-100</option>
                <option value="DIA">DIA (SPDR DJIA)</option>
              </select>
              <label class="tool-toggle" title="Show individual positions on the chart">
                <input type="checkbox" id="toggle-position-lines" checked />
                <span>Positions</span>
              </label>
            </div>
          </div>

          <div class="invest-summary" id="portfolio-summary"></div>

          <div class="chart-wrap">
            <canvas id="invest-chart" height="360" aria-label="Performance chart of Jack's picks versus the market benchmark"></canvas>
            <div id="chart-legend" class="chart-legend"></div>
          </div>

          <div class="table-scroll">
            <table class="invest-table" id="positions-table">
              <thead>
                <tr>
                  <th>Ticker</th>
                  <th>Bought</th>
                  <th>Buy px</th>
                  <th>Now</th>
                  <th>Shares</th>
                  <th>Value</th>
                  <th>Pick</th>
                  <th>Benchmark</th>
                  <th>Diff</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="positions-body"></tbody>
            </table>
          </div>

          <div id="positions-empty" class="invest-empty hidden">
            <p>No picks on the board yet.</p>
          </div>

          <div class="invest-footer">
            <p class="fineprint" id="price-updated"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
(() => {
  'use strict';
  const BENCH_DEFAULT = '^GSPC';
  const $ = (sel) => document.querySelector(sel);

  const form = $('#add-position-form');
  const ownerForm = $('#owner-form');
  const ownerCodeEl = $('#owner-code');
  const ownerStatusEl = $('#owner-status');
  const ownerPanel = $('#owner-panel');
  const ownerLock = $('#owner-lock');
  const boardTitle = $('#board-title');
  const statusEl = $('#add-position-status');
  const addBtn = $('#add-position-btn');
  const positionsBody = $('#positions-body');
  const emptyEl = $('#positions-empty');
  const summaryEl = $('#portfolio-summary');
  const canvas = $('#invest-chart');
  const legendEl = $('#chart-legend');
  const compareSelect = $('#compare-select');
  const toggleLines = $('#toggle-position-lines');
  const priceUpdatedEl = $('#price-updated');

  let positions = [];
  let ownerCode = '';
  let bench = null; // { data, error }
  let benchKey = '';
  let benchError = '';
  let positionLines = new Map(); // symbol -> {color, data|error}
  const palette = ['#e8a0a8', '#7dd3fc', '#a7f3d0', '#fcd34d', '#c4b5fd', '#f9a8d4', '#5eead4', '#fdba74', '#93c5fd', '#f0abfc'];

  const isOwner = () => ownerCode.length > 0;

  // ---------- owner API ----------
  async function api(action, extra = {}) {
    const res = await fetch('/api/picks', {
      method: action === 'get' ? 'GET' : 'POST',
      headers: { 'content-type': 'application/json' },
      body: action === 'get' ? undefined : JSON.stringify({ code: ownerCode, action, ...extra }),
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      const err = new Error(body.error || `HTTP ${res.status}`);
      err.status = res.status;
      throw err;
    }
    return body;
  }

  async function loadPositions() {
    const body = await api('get');
    positions = Array.isArray(body.positions) ? body.positions : [];
  }

  // ---------- price fetching ----------
  async function fetchPrice(symbol, from) {
    const q = new URLSearchParams({ symbol });
    if (from) q.set('from', from);
    const res = await fetch('/api/stock-price?' + q.toString());
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.error || `HTTP ${res.status}`);
    return body;
  }

  // ---------- owner-mode UI ----------
  function applyMode() {
    if (isOwner()) {
      ownerLock.classList.add('hidden');
      ownerPanel.classList.remove('hidden');
      boardTitle.textContent = 'Jack's picks (editing)';
      $('#p-date').value = $('#p-date').value || new Date().toISOString().slice(0, 10);
    } else {
      ownerPanel.classList.add('hidden');
      ownerLock.classList.remove('hidden');
      boardTitle.textContent = "Jack's picks";
    }
    renderAll();
  }
  function setOwnerStatus(kind, msg) {
    ownerStatusEl.className = 'invest-status ' + kind;
    ownerStatusEl.textContent = msg;
  }

  ownerForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const code = ownerCodeEl.value.trim();
    if (!code) return setOwnerStatus('warn', 'Enter your owner code.');
    $('#unlock-btn').disabled = true;
    setOwnerStatus('busy', 'Checking code…');
    try {
      await api('auth', { code });
    } catch (e) {
      $('#unlock-btn').disabled = false;
      return setOwnerStatus('err', 'That code is not right.');
    }
    ownerCode = code;
    setOwnerStatus('ok', 'Unlocked.');
    applyMode();
    await refreshAll();
  });

  $('#lock-btn').addEventListener('click', () => {
    ownerCode = '';
    ownerCodeEl.value = '';
    setOwnerStatus('', '');
    applyMode();
  });

  // ---------- rendering ----------
  function summaryData() {
    let cost = 0, value = 0, ok = 0;
    for (const p of positions) {
      const line = positionLines.get(p.symbol);
      cost += p.price * p.shares;
      const cur = line && line.data ? line.data.price : null;
      if (Number.isFinite(cur)) { value += cur * p.shares; ok++; }
    }
    return { cost, value, ok, gain: ok ? value - cost : null };
  }

  const usd0 = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const usd2 = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtPct = (n) => (n > 0 ? '+' : '') + n.toFixed(1) + '%';
  const fmtDate = (iso) => {
    if (!iso) return '—';
    const [y, m, d] = iso.split('-');
    return new Date(y, m - 1, d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  };
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function renderSummary() {
    const s = summaryData();
    const parts = [];
    if (positions.length) {
      parts.push(`<span class="sum-chip">Tracked: <b>${s.ok}/${positions.length}</b> priced</span>`);
      if (s.gain !== null) {
        const cls = s.gain >= 0 ? 'pos' : 'neg';
        parts.push(`<span class="sum-chip">P&amp;L: <b class="${cls}">${s.gain >= 0 ? '+' : ''}${usd2(s.gain)}</b> <span class="muted">(${usd0(s.cost)} invested)</span></span>`);
      }
      if (bench && bench.data) {
        const earliest = [...positions].sort((a, b) => (a.date < b.date ? -1 : 1))[0];
        const pct = benchPctSince(earliest.date);
        if (pct !== null) {
          const cls = pct >= 0 ? 'pos' : 'neg';
          parts.push(`<span class="sum-chip">${esc(compareSelect.options[compareSelect.selectedIndex].text)} since first buy: <b class="${cls}">${fmtPct(pct)}</b></span>`);
        }
      }
    }
    if (benchError) parts.push(`<span class="sum-chip warn">Benchmark data unavailable — check back shortly</span>`);
    summaryEl.innerHTML = parts.join('');
  }

  function benchPctSince(dateStr) {
    const d = bench.data;
    if (!d || !d.history.length || !dateStr) return null;
    const idx = d.history.findIndex((h) => h.date >= dateStr);
    if (idx < 0) return null;
    const base = d.history[idx].close;
    const last = d.history[d.history.length - 1].close;
    return (last / base - 1) * 100;
  }

  function positionPctSince(dateStr, history) {
    const idx = history.findIndex((h) => h.date >= dateStr);
    if (idx < 0) return null;
    const base = history[idx].close;
    const last = history[history.length - 1].close;
    return (last / base - 1) * 100;
  }

  function renderTable() {
    if (!positions.length) {
      positionsBody.innerHTML = '';
      emptyEl.classList.remove('hidden');
      $('#positions-table').classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    $('#positions-table').classList.remove('hidden');

    const benchHist = bench && bench.data ? bench.data.history : [];
    let rows = '';
    for (const p of positions) {
      const line = positionLines.get(p.symbol);
      const loading = !line;
      const err = line && line.error && !line.data;
      const cur = line && line.data ? line.data.price : null;
      const hist = line && line.data ? line.data.history : [];
      const pPct = !err && hist.length ? positionPctSince(p.date, hist) : null;
      const bIdx = benchHist.findIndex((h) => h.date >= p.date);
      const bPct = bIdx >= 0 ? (benchHist[benchHist.length - 1].close / benchHist[bIdx].close - 1) * 100 : null;

      const pickCell = loading ? '<span class="muted">…</span>'
        : err ? `<span class="neg">${esc(line.error)}</span>`
        : (pPct === null ? `<span class="muted">n/a</span>` : `<b class="${pPct >= 0 ? 'pos' : 'neg'}">${fmtPct(pPct)}</b>`);
      const benchCell = bPct === null ? '<span class="muted">—</span>' : `<b class="${bPct >= 0 ? 'pos' : 'neg'}">${fmtPct(bPct)}</b>`;
      const diffCell = pPct === null || bPct === null ? '<span class="muted">—</span>'
        : `<b class="${pPct - bPct >= 0 ? 'pos' : 'neg'}">${pPct - bPct >= 0 ? '+' : ''}${(pPct - bPct).toFixed(1)}pp</b>`;

      const valueCell = cur === null ? '<span class="muted">—</span>' : usd0(cur * p.shares);
      const delCell = isOwner()
        ? `<button class="icon-btn del-btn" data-del="${esc(p.id)}" title="Remove ${esc(p.symbol)}" aria-label="Remove ${esc(p.symbol)}">×</button>`
        : '';
      rows += `<tr>
        <td class="tick"><b>${esc(p.symbol)}</b>${p.name && p.name !== p.symbol ? `<span class="muted"> · ${esc(p.name)}</span>` : ''}${p.note ? `<span class="note" title="${esc(p.note)}">📝</span>` : ''}</td>
        <td>${fmtDate(p.date)}</td>
        <td>${usd2(p.price)}</td>
        <td>${cur === null ? '<span class="muted">—</span>' : usd2(cur)}${line && line.data && line.data.dayChangePct !== null ? `<span class="muted small"> (${line.data.dayChangePct >= 0 ? '+' : ''}${line.data.dayChangePct.toFixed(1)}% today)</span>` : ''}</td>
        <td>${p.shares}</td>
        <td>${valueCell}</td>
        <td>${pickCell}</td>
        <td>${benchCell}</td>
        <td>${diffCell}</td>
        <td class="row-actions">${delCell}</td>
      </tr>`;
    }
    positionsBody.innerHTML = rows;
  }

  function renderLegend() {
    const items = [];
    if (bench && bench.data) items.push(`<span class="legend-item"><i class="swatch bench"></i> ${esc(bench.data.name || benchKey)}</span>`);
    if (toggleLines.checked) {
      for (const p of positions) {
        const line = positionLines.get(p.symbol);
        if (!line) continue;
        items.push(`<span class="legend-item"><i class="swatch" style="background:${line.color}"></i> ${esc(p.symbol)} (bought ${fmtDate(p.date)})</span>`);
      }
    }
    legendEl.innerHTML = items.join('');
  }

  // ---------- chart ----------
  function setupCanvas() {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth || canvas.parentElement.clientWidth;
    const h = 360;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.height = h + 'px';
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { ctx, w, h };
  }

  function drawChart() {
    const { ctx, w, h } = setupCanvas();
    ctx.clearRect(0, 0, w, h);
    const pad = { l: 64, r: 16, t: 16, b: 34 };
    const plotW = w - pad.l - pad.r;
    const plotH = h - pad.t - pad.b;

    const series = [];
    if (bench && bench.data && bench.data.history.length > 1) {
      const hist = bench.data.history;
      const base = hist[0].close;
      series.push({ name: 'Benchmark', color: '#c41e3a', width: 2.5, points: hist.map((pt) => ({ date: pt.date, val: (pt.close / base - 1) * 100 })) });
    }
    if (toggleLines.checked) {
      for (const p of positions) {
        const line = positionLines.get(p.symbol);
        if (!line || !line.data || line.data.history.length < 2) continue;
        const hist = line.data.history;
        const idx = hist.findIndex((pt) => pt.date >= p.date);
        const startIdx = idx < 0 ? 0 : idx;
        const base = hist[startIdx].close;
        if (startIdx >= hist.length) continue;
        series.push({ name: p.symbol, color: line.color, width: 1.6, points: hist.slice(startIdx).map((pt) => ({ date: pt.date, val: (pt.close / base - 1) * 100 })) });
      }
    }
    if (!series.length) {
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.font = '14px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(positions.length ? 'Fetching prices…' : 'No picks on the board yet', w / 2, h / 2);
      return;
    }

    const allDates = [...new Set(series.flatMap((s) => s.points.map((p) => p.date)))].sort();
    const dateIndex = new Map(allDates.map((d, i) => [d, i]));
    let min = Infinity, max = -Infinity;
    for (const s of series) for (const p of s.points) { min = Math.min(min, p.val); max = Math.max(max, p.val); }
    if (min > max) { min = 0; max = 0; }
    const span = Math.max(max - min, 4);
    min -= span * 0.08; max += span * 0.08;

    const xOf = (d) => pad.l + (allDates.length < 2 ? 0 : (dateIndex.get(d) / (allDates.length - 1)) * plotW);
    const yOf = (v) => pad.t + (1 - (v - min) / (max - min)) * plotH;

    ctx.font = '11px Inter, sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    const gridSteps = 5;
    for (let i = 0; i <= gridSteps; i++) {
      const v = min + (i / gridSteps) * (max - min);
      const y = yOf(v);
      ctx.strokeStyle = 'rgba(255,255,255,0.06)';
      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(w - pad.r, y); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.45)';
      ctx.fillText((v > 0 ? '+' : '') + v.toFixed(0) + '%', pad.l - 8, y);
    }
    if (min < 0 && max > 0) {
      const y0 = yOf(0);
      ctx.strokeStyle = 'rgba(255,255,255,0.22)';
      ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(pad.l, y0); ctx.lineTo(w - pad.r, y0); ctx.stroke();
      ctx.setLineDash([]);
    }
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    const xSteps = Math.min(6, allDates.length - 1);
    for (let i = 0; i <= xSteps; i++) {
      const d = allDates[Math.round((i / xSteps) * (allDates.length - 1))];
      ctx.fillStyle = 'rgba(255,255,255,0.45)';
      ctx.fillText(fmtDate(d), xOf(d), h - pad.b + 8);
    }
    for (const s of series) {
      ctx.strokeStyle = s.color;
      ctx.lineWidth = s.width;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      let started = false;
      for (const p of s.points) {
        const x = xOf(p.date), y = yOf(p.val);
        if (!started) { ctx.moveTo(x, y); started = true; } else ctx.lineTo(x, y);
      }
      ctx.stroke();
      const endPt = s.points[s.points.length - 1];
      ctx.fillStyle = s.color;
      ctx.beginPath(); ctx.arc(xOf(endPt.date), yOf(endPt.val), 3, 0, Math.PI * 2); ctx.fill();
    }
    ctx.fillStyle = 'rgba(255,255,255,0.35)';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    ctx.font = '10px Inter, sans-serif';
    ctx.fillText('Index: 0% = value on the earliest date shown. Position lines start at their buy date.', pad.l, h - 4);
  }

  // ---------- data loading ----------
  async function loadBenchmark() {
    const key = compareSelect.value;
    if (key === benchKey && bench) { renderAll(); return; }
    benchKey = key;
    benchError = '';
    bench = null;
    renderSummary(); renderTable(); drawChart();
    try {
      const data = await fetchPrice(key, earliestDate());
      bench = { data };
    } catch (e) {
      benchError = e.message;
      bench = null;
    }
    renderAll();
  }

  function earliestDate() {
    if (!positions.length) return null;
    return [...positions].sort((a, b) => (a.date < b.date ? -1 : 1))[0].date;
  }

  async function loadPositionLines() {
    const uniqueSymbols = [...new Set(positions.map((p) => p.symbol))].sort();
    for (const p of positions) {
      const color = palette[uniqueSymbols.indexOf(p.symbol) % palette.length];
      if (positionLines.has(p.symbol)) { positionLines.get(p.symbol).color = color; continue; }
      const entry = { color, data: null, error: '' };
      positionLines.set(p.symbol, entry);
      const firstBuy = [...positions].filter((q) => q.symbol === p.symbol).sort((a, b) => (a.date < b.date ? -1 : 1))[0];
      const start = new Date(firstBuy.date + 'T00:00:00Z');
      start.setUTCDate(start.getUTCDate() - 45);
      const from = start.toISOString().slice(0, 10);
      fetchPrice(p.symbol, from)
        .then((data) => { entry.data = data; })
        .catch((e) => { entry.error = e.message; })
        .finally(() => renderAll());
    }
    for (const sym of [...positionLines.keys()]) {
      if (!uniqueSymbols.includes(sym)) positionLines.delete(sym);
    }
  }

  function renderAll() {
    renderSummary();
    renderTable();
    renderLegend();
    drawChart();
    priceUpdatedEl.textContent = bench && bench.data
      ? `Prices from Yahoo Finance · benchmark ${esc(bench.data.name)} as of ${fmtDate(new Date(bench.data.marketTime * 1000).toISOString().slice(0, 10))}`
      : '';
  }

  async function refreshAll() {
    await loadPositions();
    await Promise.all([loadPositionLines(), loadBenchmark()]);
  }

  // ---------- owner actions ----------
  function setAddStatus(kind, msg) {
    statusEl.className = 'invest-status ' + kind;
    statusEl.textContent = msg;
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const symbol = $('#p-symbol').value.trim().toUpperCase();
    let name = $('#p-name').value.trim();
    const price = parseFloat($('#p-price').value.replace(/[^0-9.]/g, ''));
    const date = $('#p-date').value;
    const sharesRaw = $('#p-shares').value.replace(/[^0-9.]/g, '');
    const shares = sharesRaw ? parseFloat(sharesRaw) : 1;
    const note = $('#p-note').value.trim();

    if (!/^[A-Z0-9.\-^]{1,12}$/.test(symbol)) return setAddStatus('warn', 'That ticker looks off — use letters/digits like AAPL, NVDA, or ^GSPC.');
    if (!Number.isFinite(price) || price <= 0) return setAddStatus('warn', 'Enter a valid buy price in USD.');
    if (!date) return setAddStatus('warn', 'Pick a buy date.');
    if (!Number.isFinite(shares) || shares <= 0 || shares > 1000000) return setAddStatus('warn', 'Enter a valid share count.');

    setAddStatus('busy', `Checking price for ${symbol}…`);
    addBtn.disabled = true;
    let livePrice = null;
    try {
      const data = await fetchPrice(symbol);
      livePrice = data.price;
      if (!name) { name = data.name || ''; $('#p-name').value = name; }
    } catch (e) {
      addBtn.disabled = false;
      return setAddStatus('err', `Couldn't verify "${symbol}": ${e.message}`);
    }
    if (Math.abs(livePrice - price) / livePrice > 0.9) {
      const ok = confirm(`${symbol} last traded at ${usd2(livePrice)}, but you entered ${usd2(price)}.\n\nOK = save as typed. Cancel = go back and fix it.`);
      if (!ok) { addBtn.disabled = false; return setAddStatus('warn', 'Cancelled — entry price looks off.'); }
    }
    try {
      const body = await api('add', { position: { symbol, name, price, date, shares, note } });
      positions = body.positions;
    } catch (e) {
      addBtn.disabled = false;
      return setAddStatus('err', e.status === 401 ? 'Owner lock expired — unlock again.' : 'Could not save: ' + e.message);
    }
    form.reset();
    $('#p-date').value = new Date().toISOString().slice(0, 10);
    addBtn.disabled = false;
    setAddStatus('ok', `Added ${symbol} @ ${usd2(price)} — live for everyone.`);
    await Promise.all([loadPositionLines(), loadBenchmark()]);
  });

  positionsBody.addEventListener('click', async (ev) => {
    const btn = ev.target.closest('[data-del]');
    if (!btn) return;
    const id = btn.getAttribute('data-del');
    const p = positions.find((x) => x.id === id);
    if (!p) return;
    if (!confirm(`Remove ${p.symbol} (bought ${fmtDate(p.date)} @ ${usd2(p.price)})?`)) return;
    try {
      const body = await api('remove', { id });
      positions = body.positions;
    } catch (e) {
      return alert(e.status === 401 ? 'Owner lock expired — unlock again.' : 'Could not remove: ' + e.message);
    }
    renderAll();
    await Promise.all([loadPositionLines(), loadBenchmark()]);
  });

  compareSelect.addEventListener('change', () => loadBenchmark());
  toggleLines.addEventListener('change', () => { renderLegend(); drawChart(); });

  $('#export-btn').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify({ app: 'jackfaris-picks', version: 1, exportedAt: new Date().toISOString(), positions }, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `jacks-picks-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  });

  $('#import-btn').addEventListener('click', () => $('#import-file').click());
  $('#import-file').addEventListener('change', async (ev) => {
    const file = ev.target.files[0];
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      const list = Array.isArray(data) ? data : data.positions;
      if (!Array.isArray(list)) throw new Error('No positions array found');
      if (!confirm(`Import ${list.length} pick(s) and REPLACE the whole board?`)) { ev.target.value = ''; return; }
      const body = await api('replace', { positions: list });
      positions = body.positions;
    } catch (e) {
      return alert('Import failed: ' + (e.status === 401 ? 'owner lock expired.' : e.message));
    }
    ev.target.value = '';
    await Promise.all([loadPositionLines(), loadBenchmark()]);
  });

  $('#clear-btn').addEventListener('click', async () => {
    if (!positions.length) return;
    if (!confirm('Clear ALL picks from the board? (Export first if you want a backup.)')) return;
    try {
      const body = await api('clear', {});
      positions = body.positions;
    } catch (e) {
      return alert(e.status === 401 ? 'Owner lock expired.' : 'Could not clear: ' + e.message);
    }
    positionLines.clear();
    renderAll();
    loadBenchmark();
  });

  let resizeTimer = null;
  window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(drawChart, 150); });

  // ---------- init ----------
  $('#p-date').value = new Date().toISOString().slice(0, 10);
  applyMode();
  refreshAll().catch(() => renderAll());
})();
</script>

