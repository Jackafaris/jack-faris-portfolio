  .chart-wrap { margin-bottom: var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--radius); background: rgba(13, 13, 15, 0.4); padding: var(--space-sm); }
  #invest-chart { width: 100%; display: block; }
  .chart-legend { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 0.6rem; padding: 0 0.25rem; }
  .legend-item { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8125rem; color: var(--color-text-light); }
