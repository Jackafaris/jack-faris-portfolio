---
import Layout from '../layouts/Layout.astro';
export const prerender = true;
---

<Layout
  title="Investing | Jack Faris"
  description="Two daily market trackers: the S&P 500 and Jack's stock of choice. Base set as of Sep 1, 2026; closes recorded at 4 PM Central every day."
>
  <section class="hero hero-compact">
    <div class="container">
      <div class="hero-text">
        <p class="hero-eyebrow">Investing</p>
        <h1>Two Trackers, Updated Daily</h1>
        <p>
          The S&amp;P&nbsp;500 and one stock of my choosing, each tracked from its
          base point of <b>September&nbsp;1, 2026</b>. Daily closes are recorded at
          4&nbsp;PM&nbsp;Central — the total shows where each one stands since the
          base. Simple by design.
        </p>
      </div>
    </div>
  </section>

  <section class="trackers-section">
    <div class="container">
      <div class="trackers-grid" id="trackers-grid">
        <!-- cards injected by the script -->
      </div>

      <div class="tracker-owner invest-panel hidden" id="tracker-owner">
        <div class="invest-panel-head">
          <h2>Trackers (editing)</h2>
          <span class="label-hint">Changes go live for everyone.</span>
        </div>
        <form id="add-stock-form" autocomplete="off">
          <div class="form-row">
            <div class="form-field">
              <label for="track-symbol">Stock ticker to track *</label>
              <input type="text" id="track-symbol" name="symbol" placeholder="PLTR"
                required pattern="[A-Za-z0-9.\-^]{1,12}" maxlength="12" />
            </div>
            <div class="form-field">
              <label for="track-name">Display name <span class="label-hint">(optional)</span></label>
              <input type="text" id="track-name" name="name" placeholder="Palantir" maxlength="60" />
            </div>
          </div>
          <div id="tracker-status" class="invest-status" role="status" aria-live="polite"></div>
          <button type="submit" class="btn btn-full" id="add-stock-btn">Track this stock</button>
        </form>
        <div class="owner-actions">
          <button class="btn-ghost btn-sm" id="lock-trackers-btn" type="button">Lock (exit)</button>
        </div>
        <p class="fineprint">
          Replacing the stock resets its base to today's close. The S&amp;P 500 tracker
          is managed by the daily record — don't remove it.
        </p>
      </div>

      <div class="tracker-lock invest-panel" id="tracker-lock">
        <div class="lock-ico" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
          </svg>
        </div>
        <h2>Owner access</h2>
        <p class="lock-copy">Anyone can view the trackers. Only the owner can add a stock.</p>
        <form id="tracker-auth-form" autocomplete="off">
          <div class="form-field">
            <label for="tracker-code">Owner code</label>
            <input type="text" id="tracker-code" name="code" placeholder="••••-••••-••••"
              autocomplete="off" spellcheck="false" style="letter-spacing:.15em" />
          </div>
          <div id="tracker-auth-status" class="invest-status" role="status" aria-live="polite"></div>
          <button type="submit" class="btn btn-full" id="tracker-auth-btn">Unlock</button>
        </form>
      </div>

      <p class="tracker-note">
        Method: each tracker's total change is measured from its base close (Sep 1, 2026)
        to the most recent recorded daily close, updated at 4&nbsp;PM&nbsp;Central after
        each market day.
      </p>
    </div>
  </section>

<script>
  import { trackersGet, trackersPost, trackersAuth, ApiError } from '../lib/trackers/api';
  import { drawSparkline } from '../lib/trackers/sparkline';
  import { trackerCardHtml, emptyTrackCardHtml } from '../lib/trackers/render';
  import { direction, totalPct } from '../lib/trackers/compute';
  import { errMsg } from '../lib/investing/format';
  import type { TrackersBody } from '../lib/trackers/types';

  const $ = (sel: string) => document.querySelector(sel) as HTMLElement;
  const grid = $('#trackers-grid');
  const statusEl = $('#tracker-status');

  let ownerCode = '';
  try { ownerCode = sessionStorage.getItem('jfpicks.owner') ?? ''; } catch { /* private mode */ }
  const isOwner = () => ownerCode.length > 0;

  function applyMode(): void {
    $('#tracker-owner').classList.toggle('hidden', !isOwner());
    $('#tracker-lock').classList.toggle('hidden', isOwner());
  }

  function setStatus(kind: string, msg: string): void {
    statusEl.className = 'invest-status ' + kind;
    statusEl.textContent = msg;
  }

  async function load(): Promise<TrackersBody | null> {
    try {
      const body = await trackersGet();
      render(body);
      return body;
    } catch (e) {
      grid.innerHTML = emptyTrackCardHtml('sp') + emptyTrackCardHtml('stock');
      return null;
    }
  }

  function render(body: TrackersBody): void {
    const sp = body.tracks.find((t) => t.symbol === '^GSPC');
    const stock = body.tracks.find((t) => t.symbol !== '^GSPC');
    const cards: string[] = [];
    if (sp) cards.push(trackerCardHtml(sp));
    else cards.push(emptyTrackCardHtml('sp'));
    if (stock) cards.push(trackerCardHtml(stock));
    else cards.push(emptyTrackCardHtml('stock'));
    grid.innerHTML = cards.join('');
    for (const t of body.tracks) {
      const canvas = document.querySelector<HTMLCanvasElement>(`.trk-spark[data-spark="${t.symbol}"]`);
      if (!canvas) continue;
      const up = totalPct(t) > 0;
      drawSparkline(canvas, t.history, up, direction(totalPct(t)) === 'flat');
    }
  }

  // ---------- owner auth ----------
  $('#tracker-auth-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const code = ($('#tracker-code').value as string).trim();
    const authStatus = $('#tracker-auth-status');
    if (!code) { authStatus.className = 'invest-status warn'; authStatus.textContent = 'Enter your owner code.'; return; }
    $('#tracker-auth-btn').disabled = true;
    authStatus.className = 'invest-status busy'; authStatus.textContent = 'Checking code…';
    try {
      await trackersAuth(code);
    } catch (e) {
      $('#tracker-auth-btn').disabled = false;
      authStatus.className = 'invest-status err'; authStatus.textContent = 'That code is not right.';
      return;
    }
    ownerCode = code;
    try { sessionStorage.setItem('jfpicks.owner', code); } catch { /* private mode */ }
    authStatus.className = 'invest-status ok'; authStatus.textContent = 'Unlocked.';
    applyMode();
  });

  $('#lock-trackers-btn').addEventListener('click', () => {
    ownerCode = '';
    try { sessionStorage.removeItem('jfpicks.owner'); } catch { /* noop */ }
    $('#tracker-code').value = '';
    applyMode();
  });

  // ---------- add / replace stock ----------
  $('#add-stock-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const symbol = ($('#track-symbol').value as string).trim().toUpperCase();
    const name = ($('#track-name').value as string).trim();
    if (!/^[A-Z0-9.\-^]{1,12}$/.test(symbol)) {
      setStatus('warn', 'That ticker looks off — use letters/digits like AAPL, NVDA, or PLTR.');
      return;
    }
    if (symbol === '^GSPC') {
      setStatus('warn', 'The S&P 500 tracker is fixed — track a stock instead.');
      return;
    }
    $('#add-stock-btn').disabled = true;
    setStatus('busy', `Verifying ${symbol}…`);
    try {
      const body = (await trackersPost('add', { code: ownerCode, symbol, name })) as unknown as TrackersBody;
      render(body);
      setStatus('ok', `Now tracking ${symbol} — base set to today's close.`);
      $('#add-stock-form').reset();
    } catch (e) {
      if (e instanceof ApiError && e.status === 401) {
        ownerCode = '';
        try { sessionStorage.removeItem('jfpicks.owner'); } catch { /* noop */ }
        applyMode();
      }
      setStatus('err', 'Could not track that stock: ' + errMsg(e));
    } finally {
      $('#add-stock-btn').disabled = false;
    }
  });

  // ---------- init ----------
  applyMode();
  load().then((body) => {
    if (isOwner() && body) {
      trackersAuth(ownerCode).catch(() => {
        ownerCode = '';
        try { sessionStorage.removeItem('jfpicks.owner'); } catch { /* noop */ }
        applyMode();
      });
    }
  });
</script>

<style>
  .trackers-section { padding: var(--space-md) 0 var(--space-lg); }
  .trackers-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  @media (max-width: 680px) { .trackers-grid { grid-template-columns: 1fr; } }

  .trk-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: var(--shadow-card);
    padding: var(--space-md);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .trk-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .trk-card.empty { box-shadow: none; background: var(--color-surface); }

  .trk-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .trk-name {
    font-weight: 800; font-size: 1.125rem; letter-spacing: -0.02em;
    font-family: var(--font-heading);
  }
  .trk-sym {
    font-size: 0.8125rem; font-weight: 700; color: var(--color-text-faint);
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-pill); padding: 0.15rem 0.6rem;
  }
  .trk-main { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.25rem; }
  .trk-price {
    font-size: 2rem; font-weight: 800; letter-spacing: -0.035em;
    font-family: var(--font-heading); line-height: 1.1;
  }
  .trk-price.muted { color: var(--color-text-faint); font-size: 1.25rem; font-weight: 600; }
  .trk-delta { font-size: 1.25rem; font-weight: 800; }
  .trk-delta.up { color: var(--color-pos); }
  .trk-delta.down { color: var(--color-neg); }
  .trk-delta.flat { color: var(--color-text-faint); }
  .trk-since { font-size: 0.875rem; color: var(--color-text-light); font-weight: 600; }
  .trk-spark { display: block; width: 100%; max-width: 220px; margin: 0.5rem 0; }
  .trk-foot {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    font-size: 0.8125rem; color: var(--color-text-light);
  }
  .trk-foot b { color: var(--color-text); font-weight: 700; }

  .tracker-owner, .tracker-lock { max-width: 520px; margin-bottom: var(--space-md); }
  .tracker-lock { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .lock-ico {
    width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    background: var(--color-accent-soft); border: 1px solid var(--color-accent-border); color: var(--color-accent-deep);
    margin-bottom: var(--space-sm);
  }
  .tracker-lock h2 { font-size: 1.375rem; margin-bottom: 0.5rem; }
  .lock-copy { font-size: 0.9375rem; margin-bottom: var(--space-sm); }
  .tracker-lock form { width: 100%; max-width: 320px; }
  .tracker-lock .form-field label { text-align: left; }
  .owner-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
  .label-hint { color: var(--color-text-faint); font-size: 0.8125rem; }
  .invest-status { font-size: 0.875rem; margin-bottom: 0.75rem; min-height: 1.2em; font-weight: 600; }
  .invest-status.busy { color: var(--color-text-light); }
  .invest-status.ok { color: var(--color-pos); }
  .invest-status.err { color: var(--color-neg); }
  .invest-status.warn { color: #b7791f; }
  .fineprint { font-size: 0.8125rem; color: var(--color-text-faint); margin-top: 0.75rem; }
  .btn-sm { padding: 0.5rem 1rem; font-size: 0.8125rem; border-radius: var(--radius-pill); }
  .btn-ghost { background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text-light); cursor: pointer; font-family: var(--font-body); font-weight: 600; }
  .btn-ghost:hover { color: var(--color-text); border-color: var(--color-text-faint); background: var(--color-surface); }
  .tracker-note { font-size: 0.875rem; color: var(--color-text-faint); max-width: 52rem; }
</style>
