---
import Layout from '../layouts/Layout.astro';
import { education } from '../data/site';
export const prerender = true;
---

<Layout
  title="About | Jack Faris"
  description="Learn about Jack Faris — sales leader, Medtronic robotics specialist, and AI builder based in St. Louis, Missouri."
>
  <section class="hero hero-compact">
    <div class="container page-intro">
      <h1 class="text-gradient">About</h1>
      <p>Results-oriented sales leader with a demonstrated record of creating and executing strategies to maximize revenue and exceed goals. Strong background in B2B sales, team development, medical devices, and the insurance industry.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header">
        <h2 class="text-gradient-red">The Story</h2>
      </div>

      <div class="content-panel glass-panel">
        <p>I grew up in St. Louis, Missouri, playing competitive soccer and tennis in high school. I then went to college at the University of Missouri — Mizzou, where I tried to do anything and everything: volunteering, joined a fraternity, played club tennis, and had multiple jobs throughout my college years. Most importantly, I constantly networked with anyone who I could bring value to, and gathered a lot of the experience that helps me today.</p>
        <p>Now, I like to have board game nights with my friends, go to my favorite local Mexican spot, and work on OpenClaw in the meantime — always looking for the next problem worth solving.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header">
        <h2 class="text-gradient-red">Education & Certifications</h2>
      </div>

      <div class="grid grid-2">
        <div class="card glass-panel">
          <div class="card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M12 3 2 8l10 5 10-5-10-5Z" />
              <path d="M6 11v4c0 2 3 4 6 4s6-2 6-4v-4" />
            </svg>
          </div>
          <h3>{education.school}</h3>
          <p>{education.degree}<br />{education.minor}</p>
        </div>

        <div class="card glass-panel">
          <div class="card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M9 12l2 2 4-4" />
              <rect x="3" y="4" width="18" height="16" rx="2" />
            </svg>
          </div>
          <h3>Certifications</h3>
          <ul class="cert-list">
            {education.certifications.map((cert) => <li>{cert}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
